#!/bin/sh
set -eu

SCRIPT_PATH=$0
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
  SCRIPT_LINK=$(readlink "$SCRIPT_PATH")
  case "$SCRIPT_LINK" in
    /*) SCRIPT_PATH=$SCRIPT_LINK ;;
    *) SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_LINK" ;;
  esac
done
PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
PYTHON_BIN="$PROJECT_ROOT/.venv/bin/python"

if [ ! -x "$PYTHON_BIN" ] && command -v git >/dev/null 2>&1; then
  if GIT_COMMON_DIR=$(git -C "$PROJECT_ROOT" rev-parse --git-common-dir 2>/dev/null); then :; else GIT_COMMON_DIR=; fi
  if [ -n "$GIT_COMMON_DIR" ]; then
    case "$GIT_COMMON_DIR" in
      /*) ;;
      *) GIT_COMMON_DIR="$PROJECT_ROOT/$GIT_COMMON_DIR" ;;
    esac
    if COMMON_ROOT=$(CDPATH= cd -- "$(dirname -- "$GIT_COMMON_DIR")" 2>/dev/null && pwd -P); then :; else COMMON_ROOT=; fi
    if [ -n "$COMMON_ROOT" ] && [ -x "$COMMON_ROOT/.venv/bin/python" ]; then
      PYTHON_BIN="$COMMON_ROOT/.venv/bin/python"
    fi
  fi
fi

# Bootstrap uses host Python before the Native venv is required.
HOST_PYTHON=
for CANDIDATE in python3.12 python3; do
  if command -v "$CANDIDATE" >/dev/null 2>&1; then
    if "$CANDIDATE" -c 'import sys; raise SystemExit(sys.version_info < (3, 12))' >/dev/null 2>&1; then
      HOST_PYTHON=$(command -v "$CANDIDATE")
      break
    fi
  fi
done
if [ -z "$HOST_PYTHON" ] && [ -x "$PYTHON_BIN" ]; then
  HOST_PYTHON=$PYTHON_BIN
fi
if [ -z "$HOST_PYTHON" ]; then
  echo 'Research Workbench requires host Python 3.12 or newer. Run setup-web first.' >&2
  exit 1
fi

cd "$PROJECT_ROOT"
exec "$HOST_PYTHON" -m research_workbench_entrypoint.bootstrap "$@"
