#!/bin/sh
set -eu

SCRIPT_PATH=$0
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
  SCRIPT_LINK=$(readlink "$SCRIPT_PATH")
  case "$SCRIPT_LINK" in
    /*) SCRIPT_PATH=$SCRIPT_LINK ;;
    *) SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_LINK" ;;
  esac
done
PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
PYTHON_BIN="$PROJECT_ROOT/.venv/bin/python"

if [ ! -x "$PYTHON_BIN" ] && command -v git >/dev/null 2>&1; then
  GIT_COMMON_DIR=$(git -C "$PROJECT_ROOT" rev-parse --git-common-dir 2>/dev/null || true)
  if [ -n "$GIT_COMMON_DIR" ]; then
    case "$GIT_COMMON_DIR" in
      /*) ;;
      *) GIT_COMMON_DIR="$PROJECT_ROOT/$GIT_COMMON_DIR" ;;
    esac
    COMMON_ROOT=$(CDPATH= cd -- "$(dirname -- "$GIT_COMMON_DIR")" 2>/dev/null && pwd -P || true)
    if [ -n "$COMMON_ROOT" ] && [ -x "$COMMON_ROOT/.venv/bin/python" ]; then
      PYTHON_BIN="$COMMON_ROOT/.venv/bin/python"
    fi
  fi
fi

if [ -n "${PYTHONPATH:-}" ]; then
  export PYTHONPATH="$PROJECT_ROOT:$PYTHONPATH"
else
  export PYTHONPATH="$PROJECT_ROOT"
fi

cd "$PROJECT_ROOT"

if [ -x "$PYTHON_BIN" ] && "$PYTHON_BIN" -c 'import click; import app.cli.main' >/dev/null 2>&1; then
  if [ -z "${RESEARCH_NODE_BINARY:-}" ] && [ -n "${HOME:-}" ]; then
    CODEX_BUNDLED_NODE="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"
    if [ -x "$CODEX_BUNDLED_NODE" ]; then
      export RESEARCH_NODE_BINARY="$CODEX_BUNDLED_NODE"
    fi
  fi
  exec "$PYTHON_BIN" -m research_workbench_entrypoint "$@"
fi

if [ -x "$PYTHON_BIN" ]; then
  export RWB_BOOTSTRAP_PYTHON_ISSUE=python_environment_unusable
fi

BOOTSTRAP_PYTHON=
if command -v python3.12 >/dev/null 2>&1; then
  BOOTSTRAP_PYTHON=$(command -v python3.12)
elif command -v python3 >/dev/null 2>&1; then
  BOOTSTRAP_PYTHON=$(command -v python3)
fi

if [ -z "$BOOTSTRAP_PYTHON" ]; then
  echo "python_runtime_unavailable" >&2
  echo "Run ./setup-web.sh --repair --no-start (Windows: setup-web.cmd --repair --no-start)." >&2
  exit 1
fi

exec "$BOOTSTRAP_PYTHON" -m research_workbench_entrypoint.web_bootstrap "$@"
