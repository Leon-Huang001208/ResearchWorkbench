# AlphaFoundry 环境配置（仅示例；请替换占位值，禁止提交真实秘密）

# 运行时配置文件路径优先级：
# 1. ALPHAFOUNDRY_CONFIG_PATH 指向的文件
# 2. ALPHAFOUNDRY_DESKTOP_DATA_DIR/.env
# 3. 项目根目录 .env
# ALPHAFOUNDRY_CONFIG_PATH=/absolute/path/to/alphafoundry.env
# ALPHAFOUNDRY_DESKTOP_DATA_DIR=/absolute/path/to/desktop-data

# 数据库
DATABASE_URL=postgresql://user:password@localhost:5432/alphafoundry

# 模型网关：支持多个 Provider，并按任务路由到 Provider + Model
LLM_PROVIDER_1_NAME=primary
LLM_PROVIDER_1_PROTOCOL=openai_compatible
LLM_PROVIDER_1_BASE_URL=https://api.example.com/v1
LLM_PROVIDER_1_API_KEY=replace-with-primary-api-key
LLM_PROVIDER_2_NAME=backup
LLM_PROVIDER_2_PROTOCOL=anthropic
LLM_PROVIDER_2_BASE_URL=https://api.anthropic.com
LLM_PROVIDER_2_API_KEY=replace-with-backup-api-key
TASK_DEFAULT_PROVIDER=primary
TASK_DEFAULT_MODEL=example-chat-model
TASK_REPORTING_PROVIDER=backup
TASK_REPORTING_MODEL=example-report-model

# 知秋账号池：JSON 可安全表达逗号、冒号和非 ASCII 字符。
# ZQ_ACCOUNTS 旧格式仍可读取；配置中心保存后统一写入 ZQ_ACCOUNTS_JSON。
ZQ_ACCOUNTS_JSON='[{"name":"primary","username":"replace-with-zq-user","password":"replace-with-zq-password"}]'
ZQ_ROTATION_ENABLED=true
ZQ_ROTATION_STRATEGY=round_robin
ZQ_MAX_RETRIES=3
ZQ_RETRY_DELAY=5
ZQ_LEASE_TIMEOUT=300
ZQ_MAX_CONSECUTIVE_FAILURES=10

# 日志
LOG_LEVEL=INFO
LOG_DIR=./logs

# iFinD 数据源
IFIND_USERNAME=your_ifind_username
IFIND_PASSWORD=your_ifind_password
IFIND_BACKEND=auto  # auto | python_sdk | http_api
IFIND_HTTP_BASE_URL=https://quantapi.10jqka.com.cn

# LLM 并发提取
LLM_EXTRACT_MAX_WORKERS=8
LLM_EXTRACT_CHUNK_SIZE=3500
LLM_EXTRACT_CHUNK_OVERLAP=300
LLM_EXTRACT_MAX_RETRIES=2
LLM_EXTRACT_LONG_TEXT_THRESHOLD=1000

# 对象存储（本地文件系统）
OBJECT_STORAGE_PATH=./data/objects

# 天软 (Tinysoft) 数据源
CJ_KEY=your-tinysoft-token
