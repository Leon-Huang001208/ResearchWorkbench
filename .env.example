# AlphaFoundry 环境配置

# 数据库
DATABASE_URL=postgresql://user:password@localhost:5432/alphafoundry

# 模型网关
MODEL_PROVIDER=volcano  # 可选: volcano, openai_compatible
VOLCANO_API_KEY=your_volcano_api_key
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# 默认模型
DEFAULT_CHAT_MODEL=gpt-4
DEFAULT_EMBEDDING_MODEL=text-embedding-ada-002

# 日志
LOG_LEVEL=INFO
LOG_DIR=./logs

# iFinD 数据源
IFIND_USERNAME=your_ifind_username
IFIND_PASSWORD=your_ifind_password
IFIND_BACKEND=auto  # auto | python_sdk | http_api
IFIND_HTTP_BASE_URL=https://quantapi.10jqka.com.cn

# LLM 并发提取
LLM_EXTRACT_MAX_WORKERS=8
LLM_EXTRACT_CHUNK_SIZE=3500
LLM_EXTRACT_CHUNK_OVERLAP=300
LLM_EXTRACT_MAX_RETRIES=2
LLM_EXTRACT_LONG_TEXT_THRESHOLD=1000

# 对象存储（本地文件系统）
OBJECT_STORAGE_PATH=./data/objects

# 天软 (Tinysoft) 数据源
CJ_KEY=your-tinysoft-token

# ── 爬虫夜间静默（本地时间整点，默认 00:00–06:00）──
# 在静默窗口内，定时爬取/回补任务自动跳过；手动 trigger 不受限。
# 设为相同值（如均为 0）可禁用静默功能，改为 22 6 则表示 22:00–06:00 静默（跨午夜）。
CRAWLER_QUIET_START=20
CRAWLER_QUIET_END=8

# ── PDF 转换 ──
# 策略优先级：auto(默认三级降级 mineru→markitdown→raw_text) / mineru / markitdown / raw_text
PDF_PREFERRED_STRATEGY=auto
# 低于此质量分的成功结果会触发降级到下一策略（0.0=禁用阈值过滤）
PDF_QUALITY_MIN_SCORE=0.0
# 转换输出目录
PDF_MARKDOWN_DIR=data/markdown
PDF_RAW_TEXT_DIR=data/raw_text
PDF_INLINE_THRESHOLD_BYTES=262144
# MinerU：是否允许在线下载 HuggingFace 模型（opendatalab/PDF-Extract-Kit-1.0）
MINERU_ALLOW_MODEL_DOWNLOAD=0
# HuggingFace 缓存根目录（Windows 开发机建议显式指定，留空则用默认 ~/.cache/huggingface）
HF_HOME=
