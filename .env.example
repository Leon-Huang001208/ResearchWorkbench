# AlphaFoundry 环境配置
#
# 优先级：启动参数 > 进程环境变量 > ALPHAFOUNDRY_CONFIG_FILE > 此文件 > 代码默认值。
# 桌面端将此文件放在：
# - Windows: %LOCALAPPDATA%\AlphaFoundry\.env
# - macOS: ~/Library/Application Support/AlphaFoundry/.env
# Web 生产环境应通过部署平台的环境变量或 Secret Manager 注入秘密。

# 可选的运行时覆盖
# ALPHAFOUNDRY_RUN_MODE=web-dev  # desktop | web-dev | web-prod
# ALPHAFOUNDRY_DESKTOP_DATA_DIR=
# ALPHAFOUNDRY_CONFIG_FILE=
# ALPHAFOUNDRY_BACKEND_URL=http://127.0.0.1:8000

# 数据库：桌面端和网页端统一使用 PostgreSQL + pgvector。
# 使用 psycopg v3 驱动；不要提交真实用户名或密码。
DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/alphafoundry

# 日志与本地输出；桌面端留空即可使用应用数据目录的子目录。
LOG_LEVEL=INFO
# LOG_DIR=
# OBJECT_STORAGE_PATH=
# PDF_MARKDOWN_DIR=
# PDF_RAW_TEXT_DIR=

# ── LLM Provider ──
# 每个 Provider 使用连续编号；新配置只使用此格式。
# LLM_PROVIDER_1_NAME=deepseek
# LLM_PROVIDER_1_PROTOCOL=openai_compatible
# LLM_PROVIDER_1_BASE_URL=https://api.example.invalid/v1
# LLM_PROVIDER_1_API_KEY=replace-with-your-api-key

# ── 任务模型路由 ──
# TASK_DEFAULT_PROVIDER=deepseek
# TASK_DEFAULT_MODEL=deepseek-chat
# TASK_EXTRACT_PROVIDER=deepseek
# TASK_EXTRACT_MODEL=deepseek-chat

# iFinD 数据源
IFIND_USERNAME=
IFIND_PASSWORD=
IFIND_BACKEND=auto  # auto | python_sdk | http_api
IFIND_HTTP_BASE_URL=https://quantapi.10jqka.com.cn

# LLM 并发提取
LLM_EXTRACT_MAX_WORKERS=8
LLM_EXTRACT_CHUNK_SIZE=3500
LLM_EXTRACT_CHUNK_OVERLAP=300
LLM_EXTRACT_MAX_RETRIES=2
LLM_EXTRACT_LONG_TEXT_THRESHOLD=1000

# 天软 (Tinysoft) 数据源
CJ_KEY=

# ── 爬虫夜间静默（本地时间整点）──
# 设为相同值（如均为 0）可禁用静默功能。
CRAWLER_QUIET_START=20
CRAWLER_QUIET_END=8

# ── PDF 转换 ──
PDF_PREFERRED_STRATEGY=auto
PDF_QUALITY_MIN_SCORE=0.0
PDF_INLINE_THRESHOLD_BYTES=262144
MINERU_ALLOW_MODEL_DOWNLOAD=0
# HF_HOME=
