{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "as_of",
        "parameters",
        "data_contract",
        "dataset_refs",
        "market_snapshot",
        "breadth",
        "sectors",
        "themes",
        "news"
    ],
    "properties": {
        "as_of": {
            "type": "string",
            "format": "date"
        },
        "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "market",
                "currency"
            ],
            "properties": {
                "market": {
                    "type": "string",
                    "minLength": 1
                },
                "currency": {
                    "const": "CNY"
                }
            }
        },
        "data_contract": {
            "$ref": "#/$defs/data_contract"
        },
        "dataset_refs": {
            "$ref": "#/$defs/dataset_refs"
        },
        "source_hashes": {
            "type": "object",
            "propertyNames": {
                "type": "string",
                "minLength": 1
            },
            "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
            }
        },
        "market_snapshot": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5000,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "date",
                    "asset",
                    "name",
                    "price",
                    "change_pct",
                    "turnover"
                ],
                "properties": {
                    "date": {
                        "type": "string",
                        "format": "date"
                    },
                    "asset": {
                        "type": "string",
                        "minLength": 1
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "price": {
                        "type": "number"
                    },
                    "change_pct": {
                        "type": "number"
                    },
                    "turnover": {
                        "type": "number"
                    }
                }
            }
        },
        "breadth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "date",
                "advances",
                "declines",
                "flat"
            ],
            "properties": {
                "date": {
                    "type": "string",
                    "format": "date"
                },
                "advances": {
                    "type": "integer",
                    "minimum": 0
                },
                "declines": {
                    "type": "integer",
                    "minimum": 0
                },
                "flat": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "sectors": {
            "$ref": "#/$defs/ranked_rows"
        },
        "themes": {
            "$ref": "#/$defs/ranked_rows"
        },
        "news": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "published_at",
                    "title",
                    "source",
                    "source_ref"
                ],
                "properties": {
                    "published_at": {
                        "type": "string",
                        "format": "date"
                    },
                    "title": {
                        "type": "string",
                        "minLength": 1
                    },
                    "source": {
                        "type": "string",
                        "minLength": 1
                    },
                    "source_ref": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        }
    },
    "$defs": {
        "data_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "provider",
                "mapping_id",
                "mapping_version",
                "units",
                "date_semantics",
                "adjustment"
            ],
            "properties": {
                "provider": {
                    "enum": [
                        "synthetic",
                        "datahub"
                    ]
                },
                "mapping_id": {
                    "const": "daily-market-brief"
                },
                "mapping_version": {
                    "const": "1.0.0"
                },
                "units": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "price",
                        "change_pct",
                        "turnover"
                    ],
                    "properties": {
                        "price": {
                            "const": "native_quote"
                        },
                        "change_pct": {
                            "const": "percent"
                        },
                        "turnover": {
                            "const": "CNY"
                        }
                    }
                },
                "date_semantics": {
                    "const": "trade_date"
                },
                "adjustment": {
                    "const": "not_applicable"
                }
            }
        },
        "dataset_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "dataset_id",
                    "provider_id",
                    "as_of",
                    "sha256"
                ],
                "properties": {
                    "dataset_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "provider_id": {
                        "enum": [
                            "synthetic",
                            "datahub",
                            "wind"
                        ]
                    },
                    "as_of": {
                        "type": "string",
                        "format": "date"
                    },
                    "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{64}$"
                    }
                }
            }
        },
        "ranked_rows": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "date",
                    "name",
                    "change_pct"
                ],
                "properties": {
                    "date": {
                        "type": "string",
                        "format": "date"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "change_pct": {
                        "type": "number"
                    }
                }
            }
        }
    }
}
