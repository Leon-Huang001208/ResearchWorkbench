{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leon-engineering.local/schemas/resource-lifecycle-v1.schema.json",
  "title": "Host resource lifecycle ledger v1",
  "type": "object",
  "required": ["schemaVersion", "host", "projects", "resources", "tasks", "records", "sequence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "host": {"type": "string", "minLength": 1},
    "projects": {"type": "object", "additionalProperties": {"type": "object", "required": ["roots", "deployments"], "properties": {
      "roots": {"type": "array", "items": {"type": "string"}},
      "deployments": {"type": "object"}, "lastResumeTask": {"type": "string"},
      "deploymentWatermarks": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
    }}},
    "resources": {"type": "array", "items": {"type": "object", "required": ["id", "path", "kind", "identity", "owners", "state", "lastUsed"], "properties": {
      "id": {"type": "string", "format": "uuid"}, "path": {"type": "string"},
      "kind": {"enum": ["temporary", "evidence", "safety-backup", "deployment", "cache"]},
      "state": {"enum": ["registered", "reclaiming"]},
      "identity": {"type": "object", "required": ["sha256", "bytes", "entries"], "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}, "entries": {"type": "integer", "minimum": 1}
      }}, "owners": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["project", "task"]}},
      "lastUsed": {"type": "integer", "minimum": 1}
    }}},
    "tasks": {"type": "array", "items": {"type": "object", "required": ["project", "task", "phase"], "properties": {"phase": {"enum": ["active", "accepted", "retired"]}}}},
    "records": {"type": "array", "items": {"type": "object", "required": ["project", "task", "proofSha256"]}},
    "sequence": {"type": "integer", "minimum": 0}, "lastSignature": {"type": "string"},
    "externalCaches": {"type": "object"}
  },
  "additionalProperties": false
}
