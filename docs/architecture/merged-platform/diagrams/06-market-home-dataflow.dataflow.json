{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "市场首页 facts-only 数据流",
    "output": "outputs/merged-platform-architecture/06-market-home-dataflow.html",
    "viewBox": [1180, 650],
    "quality_profile": "showcase"
  },
  "stages": [
    {"label": "事实来源"},
    {"label": "一致性读取"},
    {"label": "透明计算"},
    {"label": "权威快照"},
    {"label": "页面消费"}
  ],
  "nodes": [
    {"id": "marketFacts", "type": "database", "label": "行情与指数事实", "sublabel": "现有结构化表", "stage": 0, "row": 0},
    {"id": "eventFacts", "type": "database", "label": "事件事实", "sublabel": "来源与时间", "stage": 0, "row": 2},
    {"id": "repository", "type": "backend", "label": "首页 Repository", "sublabel": "一致性读窗口", "stage": 1, "row": 1, "width": 156},
    {"id": "mainline", "type": "backend", "label": "mainline-v1", "sublabel": "四项公开权重", "stage": 2, "row": 0, "tag": "30s / 60s"},
    {"id": "sections", "type": "backend", "label": "Section 组合", "sublabel": "独立 freshness", "stage": 2, "row": 2},
    {"id": "snapshot", "type": "database", "label": "market_home_snapshot", "sublabel": "历史不可重算", "stage": 3, "row": 1, "width": 166},
    {"id": "api", "type": "backend", "label": "FastAPI", "sublabel": "live / history / drill-down", "stage": 4, "row": 0},
    {"id": "sse", "type": "messagebus", "label": "SSE 失效事件", "sublabel": "section 引用", "stage": 3, "row": 3, "tag": "15s refresh"},
    {"id": "ui", "type": "frontend", "label": "市场首页", "sublabel": "facts-only", "stage": 4, "row": 2}
  ],
  "flows": [
    {"id": "marketRead", "from": "marketFacts", "to": "repository", "label": "价格、成交、宽度", "classification": "结构化事实", "variant": "emphasis"},
    {"id": "eventRead", "from": "eventFacts", "to": "repository", "label": "事件密度", "classification": "来源可追溯"},
    {"id": "rankInput", "from": "repository", "to": "mainline", "label": "一致性样本", "classification": "as_of + sample_size"},
    {"id": "sectionInput", "from": "repository", "to": "sections", "label": "分区事实", "classification": "独立 freshness"},
    {"id": "rankSnapshot", "from": "mainline", "to": "snapshot", "label": "components + version", "classification": "透明公式", "variant": "emphasis"},
    {"id": "sectionSnapshot", "from": "sections", "to": "snapshot", "label": "section payload", "classification": "事实引用"},
    {"id": "snapshotApi", "from": "snapshot", "to": "api", "label": "live / 历史快照", "classification": "权威读取", "variant": "emphasis"},
    {"id": "sectionEvent", "from": "sections", "to": "sse", "label": "section invalidated", "classification": "小型事件", "variant": "dashed"},
    {"id": "eventUi", "from": "sse", "to": "ui", "label": "event_id + as_of", "classification": "15 秒内刷新", "variant": "dashed"},
    {"id": "apiUi", "from": "api", "to": "ui", "label": "事实、公式、来源", "classification": "无 AI 摘要", "variant": "emphasis"}
  ]
}
