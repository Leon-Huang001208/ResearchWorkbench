  "cards": [
    {
      "dot": "emerald",
      "title": "主路径",
      "items": [
        "已发现",
        "已验证",
        "已启用",
        "刷新中",
        "可用"
      ]
    },
    {
      "dot": "amber",
      "title": "等待/降级",
      "items": [
        "已降级",
        "部分事实不可用",
        "不把等待态伪装成成功"
      ]
    },
    {
      "dot": "rose",
      "title": "终止与恢复",
      "items": [
        "已禁用",
        "兼容或质量失败",
