  "transitions": [
    {
      "from": "lunch",
      "to": "non_trading",
      "variant": "security",
      "route": "drop"
    },
    {
      "from": "non_trading",
      "to": "degraded",
      "variant": "security",
      "route": "drop"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "主路径",
      "items": [
        "盘前",
        "开盘",
        "午休",
        "午后开盘",
        "收盘"
      ]
    },
    {
      "dot": "amber",
      "title": "等待/降级",
      "items": [
        "非交易日",
        "只读最近快照",
