  "cards": [
    {
      "dot": "cyan",
      "title": "Registry 与 Runtime 分离",
      "items": [
        "身份固定为 Registry ID、Server 名称、版本三元组；失败返回 stale 最后成功缓存",
        "安装、探测、启用与授权分离；DSH 每次调用由 Host 重核版本、schema、风险和审批"
      ]
    },
    {
      "dot": "violet",
      "title": "研究、数据与组装分离",
      "items": [
        "资产与报告Workflow复用DataHub原件；Excel刷新、DSH研究和组装分别验证",
        "档案保留旧证据与Host质量；冻结扫描不执行模型、不改写观点"
      ]
    },
    {
      "dot": "amber",
      "title": "原Automation与窄跟踪",
      "items": [
        "今日发现单独启用、日限1次且无MCP/外发；通用任务仍锁版本",
        "原通用外发按5/30/120秒重试；研究失败不自动重试"
      ]
    }
