{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "报告数据、规范正文与正式产物数据流",
    "output": "10-excel-report-dataflow.html",
    "quality_profile": "showcase",
    "viewBox": [
      1450,
      720
    ],
    "views": [
      {
        "id": "immutable-inputs",
        "label": "不可变输入",
        "focus": [
          "version",
          "runCopy",
          "providerPolicy"
        ],
        "note": "版本锁定模板、底稿、来源映射和生产合同；母版只读，主管理员归属在运行前复验。"
      },
      {
        "id": "excel-snapshot",
        "label": "取数、校验与冻结",
        "focus": [
          "runCopy",
          "excel",
          "refreshManifest",
          "extract",
          "snapshot"
        ],
        "note": "旧版保留 Excel 刷新；新合同经私有 DataHub 取得同源 API 数据，逐组等价验证后才能切换。"
      },
      {
        "id": "research-delivery",
        "label": "研究与确定性交付",
        "focus": [
          "snapshot",
          "agents",
          "payload",
          "assembler",
          "artifacts"
        ],
        "note": "华安新合同由 DSH 写规范正文，Host 投影到原版式，检查本期图表、内容与文件版本；旧 payload 路径兼容保留。"
      }
    ]
  },
  "stages": [
    {
      "label": "锁定资源"
    },
    {
      "label": "运行与取数"
    },
    {
      "label": "校验与事实"
    },
    {
      "label": "快照与研究"
    },
    {
      "label": "正文与定稿"
    }
  ],
  "nodes": [
    {
      "id": "version",
      "type": "database",
      "label": "Workflow 版本包",
      "sublabel": "模板 / 底稿 / 映射 / Hash",
      "stage": 0,
      "row": 0,
      "tag": "只读母版"
    },
    {
      "id": "providerPolicy",
      "type": "security",
      "label": "来源与生产合同",
      "sublabel": "Excel / 已验证 API",
      "stage": 0,
      "row": 4,
      "tag": "显式版本"
    },
    {
      "id": "runCopy",
      "type": "database",
      "label": "Run 资源副本",
      "sublabel": "隔离目录 / 锁定版本",
      "stage": 1,
      "row": 0,
      "tag": "不覆盖母版"
    },
    {
      "id": "excel",
      "type": "external",
      "label": "受控数据源适配",
      "sublabel": "旧 Excel / 新 Wind API",
      "stage": 1,
      "row": 4,
      "tag": "串行准入"
    },
    {
      "id": "refreshManifest",
      "type": "security",
      "label": "取数校验回执",
      "sublabel": "数据日 / 口径 / 哈希",
      "stage": 2,
      "row": 0,
      "width": 132,
      "tag": "缺口阻断"
    },
    {
      "id": "extract",
      "type": "backend",
      "label": "Host 事实与底稿",
      "sublabel": "独立复算 / 本期工作簿",
      "stage": 2,
      "row": 4,
      "tag": "确定性"
    },
    {
      "id": "snapshot",
      "type": "database",
      "label": "共享报告快照",
      "sublabel": "report-data.json / SHA-256",
      "stage": 3,
      "row": 0,
      "tag": "单次发布"
    },
    {
      "id": "agents",
      "type": "external",
      "label": "唯一 DSH Claw",
      "sublabel": "共用证据 / 按需子任务",
      "stage": 3,
      "row": 4,
      "tag": "有界补查"
    },
    {
      "id": "payload",
      "type": "database",
      "label": "规范报告正文",
      "sublabel": "新合同：唯一正文",
      "stage": 4,
      "row": 0,
      "tag": "旧 payload 兼容"
    },
    {
      "id": "assembler",
      "type": "security",
      "label": "Host 投影与质量",
      "sublabel": "原版式 / 重开 / 哈希",
      "stage": 4,
      "row": 2,
      "tag": "通过才定稿"
    },
    {
      "id": "artifacts",
      "type": "database",
      "label": "产物与正式归档",
      "sublabel": "文件 / 质量 / 定稿状态",
      "stage": 4,
      "row": 4,
      "tag": "保留上一正式稿"
    }
  ],
  "flows": [
    {
      "id": "copyVersion",
      "from": "version",
      "to": "runCopy",
      "label": "复制锁定资源",
      "classification": "不可变来源",
      "variant": "emphasis"
    },
    {
      "id": "applyPolicy",
      "from": "providerPolicy",
      "to": "excel",
      "label": "指定来源与等价合同",
      "classification": "版本策略",
      "variant": "security"
    },
    {
      "id": "openCopy",
      "from": "runCopy",
      "to": "excel",
      "label": "仅操作 Run 副本",
      "classification": "母版只读",
      "labelDy": -28
    },
    {
      "id": "recordRefresh",
      "from": "excel",
      "to": "refreshManifest",
      "label": "原始值、数据日与回执",
      "classification": "可核验输入",
      "variant": "security",
      "labelDy": 28
    },
    {
      "id": "authorizeSnapshot",
      "from": "refreshManifest",
      "to": "extract",
      "label": "数据门通过才继续",
      "classification": "失败关闭",
      "variant": "security",
      "labelDy": -28
    },
    {
      "id": "publishSnapshot",
      "from": "extract",
      "to": "snapshot",
      "label": "冻结原始数据与事实",
      "classification": "本次运行",
      "variant": "emphasis"
    },
    {
      "id": "agentRead",
      "from": "snapshot",
      "to": "agents",
      "label": "共用快照哈希",
      "classification": "只读",
      "variant": "dashed"
    },
    {
      "id": "authorPayload",
      "from": "agents",
      "to": "payload",
      "label": "DSH 写规范正文",
      "classification": "旧版仍写 payload",
      "variant": "emphasis",
      "labelAt": [
        835,
        330
      ]
    },
    {
      "id": "projectPayload",
      "from": "payload",
      "to": "assembler",
      "label": "Host 投影并核验",
      "classification": "确定性组装",
      "variant": "security"
    },
    {
      "id": "deliver",
      "from": "assembler",
      "to": "artifacts",
      "label": "新合同通过才定稿",
      "classification": "文件与质量分开",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "保留业务资产与单一执行链",
      "items": [
        "模板、底稿、来源映射和章节属于 Workflow 版本",
        "DSH 负责研究；Host 复算、组装和核验，不增第二引擎"
      ]
    },
    {
      "dot": "amber",
      "title": "同源 API 逐组迁移",
      "items": [
        "未经对照的指标保留 Excel；不把相近品种当作等价",
        "SDK、交易日历及经济日历未核实则保持数据阻断"
      ]
    },
    {
      "dot": "emerald",
      "title": "正文与文件同版本绑定",
      "items": [
        "新合同以 research-report.json 为正文，payload 由 Host 投影",
        "本期图表与文件通过原质量门后定稿；旧正式稿继续保留"
      ]
    }
  ]
}
