{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "报告正文、正式定稿与历史验收",
    "output": "10-excel-report-dataflow.html",
    "quality_profile": "showcase",
    "viewBox": [
      1450,
      720
    ],
    "views": [
      {
        "id": "immutable-inputs",
        "label": "不可变输入",
        "focus": [
          "version",
          "runCopy",
          "providerPolicy"
        ],
        "note": "版本包只读；Host在Run冻结用途并重查owner，模型或snapshot不能自报提升。"
      },
      {
        "id": "excel-snapshot",
        "label": "取数、校验与冻结",
        "focus": [
          "runCopy",
          "excel",
          "refreshManifest",
          "extract",
          "snapshot"
        ],
        "note": "华安先由已有 Excel 插件取数，EDB 与经济日历绑定原生导出证据；实际采集结束冻结。API 待以后逐项验证切换。"
      },
      {
        "id": "research-delivery",
        "label": "研究与确定性交付",
        "focus": [
          "snapshot",
          "agents",
          "payload",
          "assembler",
          "artifacts"
        ],
        "note": "同一DSH与正文/文件门；Host先注记后取哈希，历史验收永不正式定稿，旧正式稿保留。"
      }
    ]
  },
  "stages": [
    {
      "label": "锁定资源"
    },
    {
      "label": "运行与取数"
    },
    {
      "label": "校验与事实"
    },
    {
      "label": "快照与研究"
    },
    {
      "label": "正文与定稿"
    }
  ],
  "nodes": [
    {
      "id": "version",
      "type": "database",
      "label": "Workflow 版本包",
      "sublabel": "模板 / 底稿 / 映射 / Hash",
      "stage": 0,
      "row": 0,
      "tag": "只读母版"
    },
    {
      "id": "providerPolicy",
      "type": "security",
      "label": "来源与生产合同",
      "sublabel": "Excel / 已验证 API",
      "stage": 0,
      "row": 4,
      "tag": "显式版本"
    },
    {
      "id": "runCopy",
      "type": "database",
      "label": "Run 资源副本",
      "sublabel": "隔离目录 / 冻结运行用途",
      "stage": 1,
      "row": 0,
      "tag": "不覆盖母版"
    },
    {
      "id": "excel",
      "type": "external",
      "label": "受控数据源适配",
      "sublabel": "Excel 主源 / API 待切换",
      "stage": 1,
      "row": 4,
      "tag": "串行准入"
    },
    {
      "id": "refreshManifest",
      "type": "security",
      "label": "取数校验回执",
      "sublabel": "数据日 / 口径 / 哈希",
      "stage": 2,
      "row": 0,
      "width": 132,
      "tag": "缺口阻断"
    },
    {
      "id": "extract",
      "type": "backend",
      "label": "Host 事实与底稿",
      "sublabel": "独立复算 / 本期工作簿",
      "stage": 2,
      "row": 4,
      "tag": "确定性"
    },
    {
      "id": "snapshot",
      "type": "database",
      "label": "共享报告快照",
      "sublabel": "report-data.json / SHA-256",
      "stage": 3,
      "row": 0,
      "tag": "单次发布"
    },
    {
      "id": "agents",
      "type": "external",
      "label": "唯一 DSH Claw",
      "sublabel": "共用证据 / 按需子任务",
      "stage": 3,
      "row": 4,
      "tag": "有界补查"
    },
    {
      "id": "payload",
      "type": "database",
      "label": "规范报告正文",
      "sublabel": "新合同：唯一正文",
      "stage": 4,
      "row": 0,
      "tag": "旧 payload 兼容"
    },
    {
      "id": "assembler",
      "type": "security",
      "label": "Host 投影与质量",
      "sublabel": "历史注记 / 重开 / 哈希",
      "stage": 4,
      "row": 2,
      "tag": "历史永不定稿"
    },
    {
      "id": "artifacts",
      "type": "database",
      "label": "交付与正式归档",
      "sublabel": "历史验收 / 正式资格分开",
      "stage": 4,
      "row": 4,
      "tag": "保留上一正式稿"
    }
  ],
  "flows": [
    {
      "id": "copyVersion",
      "from": "version",
      "to": "runCopy",
      "label": "锁定版本与用途",
      "classification": "不可变来源",
      "variant": "emphasis"
    },
    {
      "id": "applyPolicy",
      "from": "providerPolicy",
      "to": "excel",
      "label": "指定来源与等价合同",
      "classification": "版本策略",
      "variant": "security"
    },
    {
      "id": "openCopy",
      "from": "runCopy",
      "to": "excel",
      "label": "仅操作 Run 副本",
      "classification": "母版只读",
      "labelDy": -28
    },
    {
      "id": "recordRefresh",
      "from": "excel",
      "to": "refreshManifest",
      "label": "原始值、数据日与回执",
      "classification": "可核验输入",
      "variant": "security",
      "labelDy": 28
    },
    {
      "id": "authorizeSnapshot",
      "from": "refreshManifest",
      "to": "extract",
      "label": "数据门通过才继续",
      "classification": "失败关闭",
      "variant": "security",
      "labelDy": -28
    },
    {
      "id": "publishSnapshot",
      "from": "extract",
      "to": "snapshot",
      "label": "冻结原始数据与事实",
      "classification": "本次运行",
      "variant": "emphasis"
    },
    {
      "id": "agentRead",
      "from": "snapshot",
      "to": "agents",
      "label": "共用快照哈希",
      "classification": "只读",
      "variant": "dashed"
    },
    {
      "id": "authorPayload",
      "from": "agents",
      "to": "payload",
      "label": "DSH 写规范正文",
      "classification": "旧版仍写 payload",
      "variant": "emphasis",
      "labelAt": [
        835,
        330
      ]
    },
    {
      "id": "projectPayload",
      "from": "payload",
      "to": "assembler",
      "label": "Host 投影并核验",
      "classification": "确定性组装",
      "variant": "security"
    },
    {
      "id": "deliver",
      "from": "assembler",
      "to": "artifacts",
      "label": "交付与正式资格分开",
      "classification": "历史不可定稿",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "保留业务资产与单一执行链",
      "items": [
        "模板、底稿、来源映射和章节属于 Workflow 版本",
        "DSH 负责研究；Host 复算、组装和核验，不增第二引擎"
      ]
    },
    {
      "dot": "amber",
      "title": "Excel 先行与原生证据",
      "items": [
        "原始品种和单位不变；API 以后逐项对照再切换",
        "交易日历或原生范围证据未核实即阻断；定时关闭"
      ]
    },
    {
      "dot": "emerald",
      "title": "正文、用途与文件共同绑定",
      "items": [
        "正文真源不变；Host先加历史标签再绑定最终文件哈希",
        "历史验收可交付，不能更新正式稿或解锁定时"
      ]
    }
  ]
}
