{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "市场概览：三地行情与财经日历",
    "quality_profile": "showcase",
    "viewBox": [
      1100,
      650
    ]
  },
  "stages": [
    {
      "label": "市场页面"
    },
    {
      "label": "请求与生命周期"
    },
    {
      "label": "固定来源"
    },
    {
      "label": "完整性与存储"
    },
    {
      "label": "只读呈现"
    }
  ],
  "nodes": [
    {
      "id": "marketPage",
      "type": "frontend",
      "label": "综合总览与行情分析",
      "sublabel": "浏览缓存 / 明确刷新",
      "stage": 0,
      "row": 0
    },
    {
      "id": "marketRoutes",
      "type": "security",
      "label": "POST 准入",
      "sublabel": "刷新 / 预览 / 确认",
      "stage": 1,
      "row": 0
    },
    {
      "id": "marketService",
      "type": "backend",
      "label": "MarketService",
      "sublabel": "缓存 / 分析 / 组合上下文",
      "stage": 1,
      "row": 1
    },
    {
      "id": "publicMarket",
      "type": "cloud",
      "label": "公开行情来源",
      "sublabel": "东财 / 新浪 / 腾讯九指数",
      "stage": 2,
      "row": 2
    },
    {
      "id": "marketReader",
      "type": "backend",
      "label": "MarketReader",
      "sublabel": "仅固定12指数 / 重验身份",
      "stage": 2,
      "row": 1
    },
    {
      "id": "optionalWarehouse",
      "type": "database",
      "label": "可选个人研究仓",
      "sublabel": "已启用profile / 完整原生封包",
      "stage": 3,
      "row": 1
    },
    {
      "id": "coverage",
      "type": "backend",
      "label": "身份与完整性核验",
      "sublabel": "日期 / 来源 / 输入边界",
      "stage": 3,
      "row": 0
    },
    {
      "id": "marketCache",
      "type": "database",
      "label": "用户市场与组合文件",
      "sublabel": "分集缓存 / 观察 / 导入",
      "stage": 4,
      "row": 0
    },
    {
      "id": "marketRead",
      "type": "frontend",
      "label": "GET 行情与分析",
      "sublabel": "持仓估值 / 证据缺口",
      "stage": 4,
      "row": 2
    },
    {
      "id": "calendarPage",
      "type": "frontend",
      "label": "财经日历",
      "sublabel": "周历 / 月历 / 分类筛选",
      "stage": 0,
      "row": 3
    },
    {
      "id": "calendarHost",
      "type": "backend",
      "label": "账号内日历服务",
      "sublabel": "短快照 / 覆盖与来源",
      "stage": 1,
      "row": 3
    },
    {
      "id": "calendarSources",
      "type": "cloud",
      "label": "官方宏观排期",
      "sublabel": "FOMC / BLS CPI / 就业",
      "stage": 2,
      "row": 3
    }
  ],
  "flows": [
    {
      "id": "marketRefresh",
      "from": "marketPage",
      "to": "marketRoutes",
      "label": "显式启动",
      "variant": "security"
    },
    {
      "id": "marketAdmit",
      "from": "marketRoutes",
      "to": "marketService",
      "label": "有界任务"
    },
    {
      "id": "marketFetch",
      "from": "marketService",
      "to": "publicMarket",
      "label": "其余分区直取",
      "variant": "security",
      "route": "bottom-channel"
    },
    {
      "id": "indicesRefresh",
      "from": "marketService",
      "to": "marketReader",
      "label": "POST指数真实刷新",
      "labelDy": 55
    },
    {
      "id": "indicesFetch",
      "from": "marketReader",
      "to": "publicMarket",
      "label": "刷新必取上游",
      "variant": "security",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 35
    },
    {
      "id": "indicesCapture",
      "from": "marketReader",
      "to": "optionalWarehouse",
      "label": "完整才写仓",
      "variant": "emphasis",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "indicesCache",
      "from": "optionalWarehouse",
      "to": "marketReader",
      "label": "内部允许缓存读",
      "variant": "dashed",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "bottom"
    },
    {
      "id": "marketNormalize",
      "from": "marketService",
      "to": "coverage",
      "label": "采集与规范化",
      "route": "vertical-channel",
      "channelX": 440,
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "marketPersist",
      "from": "coverage",
      "to": "marketCache",
      "label": "完整快照原子保存",
      "variant": "emphasis",
      "route": "straight",
      "fromSide": "top",
      "toSide": "top"
    },
    {
      "id": "marketProjection",
      "from": "coverage",
      "to": "marketRead",
      "label": "完整或明确缺口",
      "route": "auto",
      "labelDy": 40
    },
    {
      "id": "marketCachedRead",
      "from": "marketCache",
      "to": "marketRead",
      "label": "失败保留旧版",
      "variant": "dashed"
    },
    {
      "id": "calendarRead",
      "from": "calendarPage",
      "to": "calendarHost",
      "label": "同源 GET",
      "variant": "security"
    },
    {
      "id": "calendarFetch",
      "from": "calendarHost",
      "to": "calendarSources",
      "label": "按需读",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "数据口径",
      "items": [
        "12/24与三地9指数分集",
        "分源报价与原生日线核对",
        "首次观察不冒充历史PIT"
      ]
    },
    {
      "dot": "amber",
      "title": "刷新与恢复",
      "items": [
        "新总览手动 / 旧行情自动",
        "行情 GET 读缓存；日历按需读",
        "行情隐藏停订阅；失败留旧版"
      ]
    },
    {
      "dot": "rose",
      "title": "系统边界",
      "items": [
        "组合预览后显式确认",
        "总分与仓位须验证齐备",
        "金元待接入 / 无交易接口"
      ]
    }
  ]
}
