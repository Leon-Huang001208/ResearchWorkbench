{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "报告 Workflow：正式生产与历史验收",
    "output": "09-report-workflow-sequence.html",
    "quality_profile": "showcase",
    "viewBox": [
      2200,
      1260
    ],
    "column_fit": "spread",
    "views": [
      {
        "id": "lock-refresh",
        "label": "锁定版本与数据合同",
        "focus": [
          "web",
          "api",
          "catalog",
          "excelTool",
          "excel",
          "snapshot"
        ],
        "note": "Host锁定正式或历史验收用途；事后采集保留真实时间，数据或日历失败仍阻断，定时关闭。"
      },
      {
        "id": "claw-research",
        "label": "共享快照与唯一 DSH",
        "focus": [
          "api",
          "snapshot",
          "dsh"
        ],
        "note": "先建立数据所属会话；数据通过后才提交模型。新合同按需使用子 Agent，不以数量证明内容质量。"
      },
      {
        "id": "deterministic-delivery",
        "label": "原版式投影与质量定稿",
        "focus": [
          "dsh",
          "api",
          "renderer",
          "files",
          "web"
        ],
        "note": "Host从唯一正文投影，最终哈希前标注历史用途；历史验收即使质量通过也不能定稿或解锁日程。"
      }
    ]
  },
  "participants": [
    {
      "id": "web",
      "type": "frontend",
      "label": "Claw 页面",
      "sublabel": "Workflow 详情 / 运行证据"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "Report Runtime",
      "sublabel": "主管理员 / 状态 / 日程"
    },
    {
      "id": "catalog",
      "type": "database",
      "label": "Workflow 版本包",
      "sublabel": "模板 / 底稿 / 映射"
    },
    {
      "id": "excelTool",
      "type": "backend",
      "label": "数据适配与校验",
      "sublabel": "旧 Excel / 私有 DataHub"
    },
    {
      "id": "excel",
      "type": "external",
      "label": "已授权数据源",
      "sublabel": "Wind API / Excel 插件"
    },
    {
      "id": "snapshot",
      "type": "database",
      "label": "运行快照",
      "sublabel": "manifest / SHA-256"
    },
    {
      "id": "dsh",
      "type": "external",
      "label": "唯一 DSH Claw",
      "sublabel": "写作 / 有界补查"
    },
    {
      "id": "renderer",
      "type": "security",
      "label": "Host 质量与组装",
      "sublabel": "原质量门 / 无网络投影"
    },
    {
      "id": "files",
      "type": "database",
      "label": "本次报告与归档",
      "sublabel": "文件 / 质量 / 定稿状态"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 470,
      "label": "资源与数据前置检查"
    },
    {
      "from": 490,
      "to": 800,
      "label": "冻结证据与 DSH 写作"
    },
    {
      "from": 820,
      "to": 1150,
      "label": "确定性投影与用途隔离"
    }
  ],
  "messages": [
    {
      "id": "manualRun",
      "from": "web",
      "to": "api",
      "y": 180,
      "label": "显式正式或历史验收：核验主管理员",
      "variant": "emphasis"
    },
    {
      "id": "lockVersion",
      "from": "api",
      "to": "catalog",
      "y": 224,
      "label": "锁定版本、截止与正式/历史用途",
      "variant": "security"
    },
    {
      "id": "refreshCopy",
      "from": "api",
      "to": "excelTool",
      "y": 268,
      "label": "Excel 取数 / 原生证据"
    },
    {
      "id": "excelRefresh",
      "from": "excelTool",
      "to": "excel",
      "y": 312,
      "label": "已授权调用；无静默换源",
      "variant": "emphasis"
    },
    {
      "id": "excelResult",
      "from": "excel",
      "to": "excelTool",
      "y": 356,
      "label": "原始值 / 实际数据日 / 失败码",
      "variant": "return"
    },
    {
      "id": "refreshManifest",
      "from": "excelTool",
      "to": "snapshot",
      "y": 400,
      "label": "同源对照、数据合同与哈希",
      "variant": "security"
    },
    {
      "id": "blockedData",
      "from": "excelTool",
      "to": "api",
      "y": 444,
      "label": "失败 → blocked_data，不发模型",
      "variant": "return"
    },
    {
      "id": "materialize",
      "from": "api",
      "to": "snapshot",
      "y": 520,
      "label": "冻结快照、事实与本期工作簿",
      "variant": "emphasis"
    },
    {
      "id": "createClaw",
      "from": "api",
      "to": "dsh",
      "y": 564,
      "label": "数据通过后提交原生 Claw 回合",
      "variant": "emphasis"
    },
    {
      "id": "readSnapshot",
      "from": "snapshot",
      "to": "dsh",
      "y": 608,
      "label": "共用同一快照；不重复取数",
      "variant": "dashed"
    },
    {
      "id": "activity",
      "from": "dsh",
      "to": "api",
      "y": 652,
      "label": "真实 Tool / 子 Agent / 用量",
      "variant": "dashed"
    },
    {
      "id": "writePayload",
      "from": "dsh",
      "to": "snapshot",
      "y": 696,
      "label": "旧 payload；新 research-report.json",
      "variant": "emphasis"
    },
    {
      "id": "turnEnd",
      "from": "dsh",
      "to": "api",
      "y": 740,
      "label": "回合结束 ≠ 正式定稿",
      "variant": "return"
    },
    {
      "id": "project",
      "from": "api",
      "to": "renderer",
      "y": 852,
      "label": "Host 投影规范正文与本期图表",
      "variant": "security"
    },
    {
      "id": "assembleFiles",
      "from": "renderer",
      "to": "files",
      "y": 896,
      "label": "原版式；历史标签先于文件哈希",
      "variant": "emphasis"
    },
    {
      "id": "reopen",
      "from": "files",
      "to": "renderer",
      "y": 940,
      "label": "重开文件；核对实际内容与哈希",
      "variant": "return"
    },
    {
      "id": "deliveryState",
      "from": "renderer",
      "to": "api",
      "y": 984,
      "label": "正式通过可定稿；历史验收永不定稿",
      "variant": "return"
    },
    {
      "id": "latePayload",
      "from": "web",
      "to": "api",
      "y": 1028,
      "label": "显式重试：复用已知原研究",
      "variant": "dashed"
    },
    {
      "id": "runEvidence",
      "from": "api",
      "to": "web",
      "y": 1072,
      "label": "执行 / 交付 / 质量 / 正式资格"
    },
    {
      "id": "download",
      "from": "web",
      "to": "files",
      "y": 1116,
      "label": "历史验收稿与上一正式稿分开保留"
    }
  ],
  "activations": [
    {
      "participant": "api",
      "from": 174,
      "to": 1078,
