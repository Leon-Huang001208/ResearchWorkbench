    },
    {
      "participant": "snapshot",
      "from": 392,
      "to": 704,
      "type": "database"
    },
    {
      "participant": "dsh",
      "from": 556,
      "to": 748,
      "type": "external"
    },
    {
      "participant": "renderer",
      "from": 844,
      "to": 992,
      "type": "security"
    },
    {
      "participant": "files",
      "from": 888,
      "to": 1124,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "旧版与新合同分别保留",
      "items": [
        "历史版本继续按原交付合同运行；不补认证旧产物",
        "主管理员显式准备并发布华安生产合同，日程默认关闭"
      ]
    },
    {
      "dot": "amber",
      "title": "数据失败先于模型",
      "items": [
        "Excel 日历与导出范围需真实核验；API 以后校准切源",
        "一交易日滞后上限；失败或未知状态不自动重发付费研究"
      ]
    },
    {
      "dot": "emerald",
      "title": "正式与历史用途分别绑定",
      "items": [
        "正文、模板、快照、用途与产物哈希共同绑定",
        "历史文件显著标注，不改正式稿或解锁日程"
      ]
    }
  ]
}
