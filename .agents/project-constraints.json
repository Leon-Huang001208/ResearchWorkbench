{
  "schemaVersion": 1,
  "researchArchitectureMap": "docs/architecture/research-web/architecture-map.json",
  "requiredFiles": [
    "AGENTS.md",
    "README.md",
    "docs/README.md",
    "docs/documentation-governance.json",
    "docs/ARCHITECTURE.md",
    "docs/DEVELOPMENT_MAP.md",
    "docs/AGENT_WORKFLOW.md",
    "docs/actions-budget.md",
    "docs/desktop_packaging.md",
    "docs/architecture/research-web/readme-review.json",
    "scripts/check_documentation_governance.mjs"
  ],
  "readmeReview": {
    "receipt": "docs/architecture/research-web/readme-review.json",
    "readme": "README.md",
    "sourcePrefixes": [
      "app/research_web/",
      "app/cli/",
      "research_workbench_entrypoint/"
    ],
    "sourceFiles": [
      "pyproject.toml",
      "package.json"
    ]
  },
  "changeRules": [
    {
      "name": "桌面改动需要跨平台交付文档",
      "sourcePrefixes": [
        "src-tauri/",
        "desktop/",
        "scripts/desktop/",
        "core/settings/",
        "services/desktop_platform/",
        "data_layer/adapters/wind/"
      ],
      "requiredDocuments": [
        "docs/desktop_packaging.md"
      ]
    }
  ],
  "contentRules": [
    {
      "name": "服务层改动必须包含项目日志与显式错误处理",
      "sourcePrefixes": [
        "services/"
      ],
      "extensions": [
        ".py"
      ],
      "requireAll": [
        "get_logger",
        "except "
      ]
    }
  ],
  "dependencyRules": [
    {
      "name": "核心层不得反向依赖应用或服务层",
      "sourcePrefixes": [
        "core/"
      ],
      "extensions": [
        ".py"
      ],
      "forbiddenPatterns": [
        "from services.",
        "import services.",
        "from app.",
        "import app."
      ]
    },
    {
      "name": "数据层不得反向依赖应用或服务层",
      "sourcePrefixes": [
        "data_layer/"
      ],
      "extensions": [
        ".py"
      ],
      "forbiddenPatterns": [
        "from services.",
        "import services.",
        "from app.",
        "import app."
      ]
    },
    {
      "name": "服务层不得反向依赖应用层",
      "sourcePrefixes": [
        "services/"
      ],
      "extensions": [
        ".py"
      ],
      "forbiddenPatterns": [
        "from app.",
        "import app."
      ]
    }
  ],
  "ciRules": [
    {
      "name": "桌面验证必须包含原生 Windows 与健康检查",
      "workflow": ".github/workflows/desktop-verify.yml",
      "requireAll": [
        "windows-2022",
        "check_sidecar_health.py",
        "setup_required"
      ]
    },
    {
      "name": "项目约束必须由轻量 CI 执行",
      "workflow": ".github/workflows/project-constraints.yml",
      "requireAll": [
        "ubuntu-latest",
        ".agents/project-constraints.mjs",
        "--changed-file",
        "check_documentation_governance.mjs",
        "generate_py_file_index.py --check",
        "actions_quota_governance.test.mjs",
        "concurrency:",
        "cancel-in-progress: true",
        "timeout-minutes: 10"
      ]
    },
    {
      "name": "Web 一键安装必须在原生 macOS 与 Windows 持续验证",
      "workflow": ".github/workflows/research-web-bootstrap.yml",
      "requireAll": [
        "macos-14",
        "windows-2022",
        "setup-web.sh --no-start",
        "setup-web.cmd --no-start",
        "web doctor --json",
        "cjpy') == '0.5.2'",
        "tinysoft",
        "callable",
        "scripts/setup_web.py",
        "requirements/web.lock",
        "if: success()",
        "if: failure()",
        "retention-days: 3"
      ]
    },
    {
      "name": "Research Web 日常检查必须使用有界 Linux workflow",
      "workflow": ".github/workflows/research-web-checks.yml",
      "requireAll": [
        "ubuntu-latest",
        "timeout-minutes: 20",
        "cancel-in-progress: true",
        "tests/research_web/test_protocol.py",
        "tests/research_web/test_integration_coordinator.py",
        "tests/research_web/test_documentation.py",
        "tests/research_web/test_doc_sync.py",
        "tests/research_web/test_cli_lazy.py",
        "tests/javascript/research_web*.test.mjs"
      ]
    },
    {
      "name": "Windows Web 验证必须保持窄路径与短期证据",
      "workflow": ".github/workflows/research-web-windows-verify.yml",
      "requireAll": [
        "windows-2022",
        "app/research_web/local_integrations/**",
        "app/research_web/runtime_auth.py",
        "app/research_web/service_manager.py",
        "retention-days: 3"
      ]
    },
    {
      "name": "Tabbit 双平台验证必须保持手动触发",
      "workflow": ".github/workflows/research-web-tabbit.yml",
      "requireAll": [
        "workflow_dispatch:",
        "macos-14",
        "windows-2022"
      ]
    }
  ]
}
