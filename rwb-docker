#!/bin/sh
# Admin-only entrypoint. No host Python/Node or global package installation.
set -eu
umask 077
PROJECT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -f "$PROJECT/.git" ]; then
  GIT_DIRECTORY=$(sed -n 's/^gitdir: //p' "$PROJECT/.git")
  GIT_COMMON=$(CDPATH= cd -- "$GIT_DIRECTORY/../.." && pwd -P)
else
  GIT_COMMON="$PROJECT/.git"
fi
ROOT=${RWB_DOCKER_HOME:-"$HOME/.local/share/rwb-docker"}
case "$ROOT" in /*) ;; *) echo 'docker_home_must_be_absolute' >&2; exit 1;; esac
test ! -L "$ROOT" || { echo 'docker_home_alias' >&2; exit 1; }
mkdir -p "$ROOT"
ROOT=$(CDPATH= cd -- "$ROOT" && pwd -P)
if [ "$(uname -s)" = Darwin ]; then
  RWB_ROOT_IDENTITY=$(stat -f '%u %Lp' "$ROOT")
else
  RWB_ROOT_IDENTITY=$(stat -c '%u %a' "$ROOT")
fi
test "$RWB_ROOT_IDENTITY" = "$(id -u) 700" || { echo docker_home_ownership_unsafe >&2; exit 1; }
test ! -L "$ROOT/logs" || { echo docker_log_alias >&2; exit 1; }
mkdir -p "$ROOT/logs"
for RWB_RECORD in builder.id control.image runtime.image dev.image; do
  test ! -L "$ROOT/$RWB_RECORD" || { echo docker_record_alias >&2; exit 1; }
done
mkdir "$ROOT/operation.lock" || { echo 'docker_operation_busy' >&2; exit 1; }
BUILDING=0
finish() {
  RWB_EXIT=$?
  if [ "$BUILDING" = 1 ] && [ -f "$ROOT/builder.id" ]; then
    RWB_FINAL_ID=$(docker inspect --format '{{.Id}}' buildx_buildkit_rwb-dev-builder0) || RWB_EXIT=1
    RWB_RECORDED_ID=$(cut -d ' ' -f1 "$ROOT/builder.id")
    RWB_FINAL_CONFIG=$(docker inspect --format '{{.Id}} {{.Config.Image}} {{.HostConfig.Memory}} {{.HostConfig.MemorySwap}} {{.HostConfig.CpuQuota}} {{.HostConfig.CpuPeriod}} {{.HostConfig.PidsLimit}} {{.HostConfig.LogConfig.Type}} {{index .HostConfig.LogConfig.Config "max-size"}} {{index .HostConfig.LogConfig.Config "max-file"}} {{index .Config.Labels "io.research-workbench.manager"}}' buildx_buildkit_rwb-dev-builder0) || RWB_EXIT=1
    if [ "$RWB_FINAL_ID" = "$RWB_RECORDED_ID" ] && [ "$RWB_FINAL_CONFIG" = "$(cat "$ROOT/builder.id")" ]; then
      docker stop "$RWB_FINAL_ID" >/dev/null || RWB_EXIT=1
    else
      echo builder_cleanup_ownership_mismatch >&2
      RWB_EXIT=1
    fi
  fi
  rmdir "$ROOT/operation.lock" || RWB_EXIT=1
  exit "$RWB_EXIT"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
LOG="$ROOT/logs/operations.log"
fail() { echo "$1" >&2; echo "$1" >> "$LOG"; exit 1; }
command -v docker >/dev/null 2>&1 || fail docker_unavailable
# Use only the already configured, credentials-free macOS loopback proxy.
# This is process-local transport, never forwarded to application containers.
if [ -z "${HTTP_PROXY:-${http_proxy:-}}${HTTPS_PROXY:-${https_proxy:-}}" ] && command -v scutil >/dev/null 2>&1; then
  RWB_SYSTEM_PROXY=$(scutil --proxy)
  RWB_HTTP_ENABLED=$(printf '%s\n' "$RWB_SYSTEM_PROXY" | sed -n 's/.*HTTPEnable : //p')
  RWB_HTTPS_ENABLED=$(printf '%s\n' "$RWB_SYSTEM_PROXY" | sed -n 's/.*HTTPSEnable : //p')
  RWB_HTTP_HOST=$(printf '%s\n' "$RWB_SYSTEM_PROXY" | sed -n 's/.*HTTPProxy : //p')
  RWB_HTTPS_HOST=$(printf '%s\n' "$RWB_SYSTEM_PROXY" | sed -n 's/.*HTTPSProxy : //p')
  RWB_HTTP_PORT=$(printf '%s\n' "$RWB_SYSTEM_PROXY" | sed -n 's/.*HTTPPort : //p')
  RWB_HTTPS_PORT=$(printf '%s\n' "$RWB_SYSTEM_PROXY" | sed -n 's/.*HTTPSPort : //p')
  if [ "$RWB_HTTP_ENABLED:$RWB_HTTPS_ENABLED" = 1:1 ] && [ "$RWB_HTTP_HOST:$RWB_HTTP_PORT" = "$RWB_HTTPS_HOST:$RWB_HTTPS_PORT" ]; then
    case "$RWB_HTTP_HOST" in
      127.0.0.1|localhost)
        case "$RWB_HTTP_PORT" in ''|*[!0-9]*) fail system_proxy_port_invalid;; esac
        test "${#RWB_HTTP_PORT}" -le 5 && test "$RWB_HTTP_PORT" -gt 0 && test "$RWB_HTTP_PORT" -le 65535 || fail system_proxy_port_invalid
        HTTP_PROXY="http://$RWB_HTTP_HOST:$RWB_HTTP_PORT"
        HTTPS_PROXY=$HTTP_PROXY
        NO_PROXY=localhost,127.0.0.1,::1
        export HTTP_PROXY HTTPS_PROXY NO_PROXY;;
    esac
  fi
fi
docker info >/dev/null
DESKTOP_PROXY=$(docker info --format '{{.HTTPProxy}}')
case "$DESKTOP_PROXY" in
  http.docker.internal:3128|http://http.docker.internal:3128) BUILDER_PROXY=http://http.docker.internal:3128;;
  '') BUILDER_PROXY=;;
  *) fail builder_proxy_requires_explicit_configuration;;
esac
BUILDER=rwb-dev-builder
CONTAINER=buildx_buildkit_rwb-dev-builder0
admit_cold_build() {
  test -z "$(docker ps -q --filter label=io.research-workbench.environment=stage)" || fail stop_stage_before_cold_build
  RWB_OTHER_MEMORY=0
  for RWB_RUNNING_ID in $(docker ps -q); do
    test "$(docker inspect --format '{{.Name}}' "$RWB_RUNNING_ID")" != "/$CONTAINER" || continue
    RWB_RUNNING_MEMORY=$(docker inspect --format '{{.HostConfig.Memory}}' "$RWB_RUNNING_ID")
    test "$RWB_RUNNING_MEMORY" -gt 0 || fail unbounded_running_container
    RWB_OTHER_MEMORY=$((RWB_OTHER_MEMORY + RWB_RUNNING_MEMORY))
  done
  RWB_VM_MEMORY=$(docker info --format '{{.MemTotal}}')
  test $((RWB_OTHER_MEMORY + 7 * 1024 * 1024 * 1024)) -le "$RWB_VM_MEMORY" || fail vm_budget_requires_stopping_dev_or_16g_vm
}
ensure_builder() {
  if [ -f "$ROOT/builder.id" ]; then
    ACTUAL=$(docker inspect --format '{{.Id}} {{.Config.Image}} {{.HostConfig.Memory}} {{.HostConfig.MemorySwap}} {{.HostConfig.CpuQuota}} {{.HostConfig.CpuPeriod}} {{.HostConfig.PidsLimit}} {{.HostConfig.LogConfig.Type}} {{index .HostConfig.LogConfig.Config "max-size"}} {{index .HostConfig.LogConfig.Config "max-file"}} {{index .Config.Labels "io.research-workbench.manager"}}' "$CONTAINER")
    test "$ACTUAL" = "$(cat "$ROOT/builder.id")" || fail builder_ownership_mismatch
    test "$(docker volume inspect --format '{{index .Labels "io.research-workbench.manager"}}' rwb-dev-builder-state)" = "$ROOT" || fail builder_volume_mismatch
    cmp -s "$ROOT/buildkitd.toml" "$PROJECT/docker/buildkitd.toml" || fail builder_configuration_mismatch
    docker start "$CONTAINER" >/dev/null
  else
    test -z "$(docker ps -aq --filter name="^/$CONTAINER$")" || fail builder_unregistered
    if docker buildx inspect "$BUILDER" > /dev/null 2> "$ROOT/logs/builder-discovery.log"; then
      fail builder_unregistered
    fi
    cp "$PROJECT/docker/buildkitd.toml" "$ROOT/buildkitd.toml"
    test -z "$(docker volume ls -q --filter name='^rwb-dev-builder-state$')" || fail builder_volume_unregistered
    docker volume create --label io.research-workbench.manager="$ROOT" rwb-dev-builder-state >/dev/null
    docker buildx create --name "$BUILDER" --driver docker-container \
      --driver-opt memory=5g,memory-swap=5g,cpu-quota=200000,cpu-period=100000 \
      --buildkitd-config "$ROOT/buildkitd.toml" >/dev/null
    docker run -d --name "$CONTAINER" --privileged --memory 5g --memory-swap 5g \
      --cpu-period 100000 --cpu-quota 200000 --pids-limit 256 \
      --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
      --label io.research-workbench.manager="$ROOT" \
      --env "HTTP_PROXY=$BUILDER_PROXY" --env "HTTPS_PROXY=$BUILDER_PROXY" \
      --mount type=volume,src=rwb-dev-builder-state,dst=/var/lib/buildkit \
      --mount "type=bind,src=$ROOT/buildkitd.toml,dst=/etc/buildkit/buildkitd.toml,readonly" \
      moby/buildkit:v0.28.0 --config /etc/buildkit/buildkitd.toml >/dev/null
    docker inspect --format '{{.Id}} {{.Config.Image}} {{.HostConfig.Memory}} {{.HostConfig.MemorySwap}} {{.HostConfig.CpuQuota}} {{.HostConfig.CpuPeriod}} {{.HostConfig.PidsLimit}} {{.HostConfig.LogConfig.Type}} {{index .HostConfig.LogConfig.Config "max-size"}} {{index .HostConfig.LogConfig.Config "max-file"}} {{index .Config.Labels "io.research-workbench.manager"}}' "$CONTAINER" > "$ROOT/builder.id"
  fi
  docker buildx inspect "$BUILDER" --bootstrap
}
case "${1:-help}" in
  builder-cold-budget)
    admit_cold_build
    BUILDING=1
    ensure_builder
    docker update --memory 5g --memory-swap 5g "$CONTAINER" >/dev/null
    docker inspect --format '{{.Id}} {{.Config.Image}} {{.HostConfig.Memory}} {{.HostConfig.MemorySwap}} {{.HostConfig.CpuQuota}} {{.HostConfig.CpuPeriod}} {{.HostConfig.PidsLimit}} {{.HostConfig.LogConfig.Type}} {{index .HostConfig.LogConfig.Config "max-size"}} {{index .HostConfig.LogConfig.Config "max-file"}} {{index .Config.Labels "io.research-workbench.manager"}}' "$CONTAINER" > "$ROOT/builder.id"
    echo cold_build_budget_registered; exit 0;;
  bootstrap)
    admit_cold_build
    BUILDING=1
    ensure_builder
    docker buildx build --builder "$BUILDER" --platform linux/arm64 --load \
      -f "$PROJECT/docker/Dockerfile.control" -t rwb-control:g01 "$PROJECT"
    docker image inspect --format '{{.Id}}' rwb-control:g01 > "$ROOT/control.image"
    echo 'controller_ready'; exit 0;;
  build)
    admit_cold_build
    BUILDING=1
    test -f "$ROOT/control.image" || fail run_bootstrap_first
    ensure_builder
    SOURCE_SHA=$(docker run --rm --read-only --network none --memory 128m --memory-swap 128m \
      --cpus .5 --pids-limit 32 --log-opt max-size=10m --log-opt max-file=3 \
      --mount "type=bind,src=$PROJECT,dst=$PROJECT,readonly" \
      --mount "type=bind,src=$GIT_COMMON,dst=$GIT_COMMON,readonly" \
      --entrypoint git "$(cat "$ROOT/control.image")" \
      -c "safe.directory=$PROJECT" -C "$PROJECT" rev-parse HEAD)
    docker buildx build --builder "$BUILDER" --platform linux/arm64 --load \
      --label "org.opencontainers.image.revision=$SOURCE_SHA" \
      -t rwb-candidate:g01 "$PROJECT"
    IMAGE=$(docker image inspect --format '{{.Id}}' rwb-candidate:g01)
    printf '%s\n' "$IMAGE" > "$ROOT/runtime.image"
    cat "$PROJECT/Dockerfile" "$PROJECT/docker/Dockerfile.dev" > "$ROOT/dev.Dockerfile"
    docker buildx build --builder "$BUILDER" --platform linux/arm64 --load \
      --label "org.opencontainers.image.revision=$SOURCE_SHA" \
      -f "$ROOT/dev.Dockerfile" \
      -t rwb-development:g01 "$PROJECT"
    docker image inspect --format '{{.Id}}' rwb-development:g01 > "$ROOT/dev.image"
    echo "candidate_image=$IMAGE"; exit 0;;
  help)
    echo './rwb-docker bootstrap | build | dev|stage|prod INSTANCE register|up|status|doctor|stop|rebuild|exec|cleanup|replace-image|enable-model-credentials|credential-probe [options]'
    exit 0;;
esac
test -f "$ROOT/control.image" || fail run_bootstrap_first
CONTROL=$(cat "$ROOT/control.image")
case "$CONTROL" in sha256:*) ;; *) fail controller_image_invalid;; esac
case "${1:-}" in dev|stage|prod) ;; *) fail environment_required;; esac
echo managed_operation >> "$LOG"
# Only this short-lived administrator gets daemon authority. No secrets/env forwarded.
docker run --rm --read-only --memory 256m --memory-swap 256m --cpus .5 --pids-limit 64 \
  --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
  --tmpfs /tmp:rw,nosuid,nodev,size=64m \
  --mount type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock \
  --mount "type=bind,src=$ROOT,dst=/ledger" \
  --mount "type=bind,src=$PROJECT,dst=$PROJECT,readonly" \
  --mount "type=bind,src=$GIT_COMMON,dst=$GIT_COMMON,readonly" \
  --entrypoint python \
  -e "RWB_MANAGER_ROOT=$ROOT" -e "RWB_WORKTREE=$PROJECT" "$CONTROL" "$PROJECT/docker/manage.py" "$@"
