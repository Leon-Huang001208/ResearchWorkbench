{
  "name": "research-workbench-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:preview": "node scripts/desktop/run_preview.js",
    "desktop:build": "tauri build",
    "desktop:build:debug": "tauri build --debug --bundles app",
    "desktop:sidecar": "python scripts/desktop/build_sidecar.py",
    "desktop:prepare-sidecar": "python scripts/desktop/prepare_tauri_sidecar.py",
    "desktop:release-config": "python scripts/desktop/write_tauri_release_config.py",
    "desktop:build:release": "tauri build --config src-tauri/tauri.release.conf.json",
    "desktop:restart": "bash scripts/desktop/restart_app.sh",
    "dsh:bootstrap": "node scripts/dsh/bootstrap_harness.mjs",
    "dsh:web": "node scripts/dsh/run_harness.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.8.4"
  },
  "dependencies": {
    "@tauri-apps/plugin-notification": "2.4.0"
  }
}
