#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT_FILE="${RESEARCH_PROJECT_ROOT_FILE:-$HOME/Library/Application Support/Research Workbench/dev-project-root}"

resolve_project_root() {
    if [[ -n "${RESEARCH_PROJECT_ROOT:-}" ]]; then
        printf '%s\n' "$RESEARCH_PROJECT_ROOT"
        return 0
    fi

    if [[ -f "$PROJECT_ROOT_FILE" ]]; then
        local configured_root
        IFS= read -r configured_root < "$PROJECT_ROOT_FILE" || true
        if [[ -n "$configured_root" ]]; then
            printf '%s\n' "$configured_root"
            return 0
        fi
    fi

    local repo_root
    repo_root="$(cd "$SCRIPT_DIR/../.." && pwd)"
    if [[ -x "$repo_root/scripts/desktop/run_backend.sh" ]]; then
        printf '%s\n' "$repo_root"
        return 0
    fi

    echo "Research Workbench project root is not configured. Set RESEARCH_PROJECT_ROOT or write $PROJECT_ROOT_FILE." >&2
    return 78
}

REPO_ROOT="$(resolve_project_root)"
RUN_BACKEND="$REPO_ROOT/scripts/desktop/run_backend.sh"

if [[ ! -x "$RUN_BACKEND" ]]; then
    echo "Research Workbench backend launcher not found or not executable: $RUN_BACKEND" >&2
    exit 78
fi

export RESEARCH_PROJECT_ROOT="$REPO_ROOT"
exec "$RUN_BACKEND" "$@"
