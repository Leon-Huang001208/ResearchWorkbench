{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the AlphaFoundry desktop shell",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "process:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/alphafoundry-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
