diff --git a/internal/application/service/retrieval_only.go b/internal/application/service/retrieval_only.go
--- /dev/null
+++ b/internal/application/service/retrieval_only.go
@@ -0,0 +1,27 @@
+package service
+
+import (
+	"github.com/Tencent/WeKnora/internal/types"
+	"os"
+)
+
+// The dedicated candidate persists this operator-owned setting on app and worker processes.
+// Only the exact opt-in enables the policy. Existing installations remain unchanged.
+func retrievalOnlyEnabled() bool { return os.Getenv("WEKNORA_RETRIEVAL_ONLY") == "1" }
+
+func enforceRetrievalOnlyConfig(eff types.EffectiveProcessConfig) types.EffectiveProcessConfig {
+	if !retrievalOnlyEnabled() {
+		return eff
+	}
+	eff.SummaryEnabled = false
+	eff.EnableMultimodel = false
+	eff.VLMConfig = types.VLMConfig{}
+	eff.ASRConfig = types.ASRConfig{}
+	eff.QuestionGenerationConfig.Enabled = false
+	eff.GraphEnabled = false
+	eff.ExtractConfig.Enabled = false
+	eff.ImageAttrsEnabled = false
+	eff.ImageVectorEnabled = false
+	eff.ImagePipelineParams = nil
+	return eff
+}
