+		require.True(t, retrievalOnlyRouteAllowed(http.MethodPost, path), path)
+	}
+	for _, path := range []string{"/api/v1/knowledge/d/regenerate-summary", "/api/v1/chunks/by-id/c/questions/regenerate", "/api/v1/knowledge-bases/kb/profile/generate", "/api/v1/knowledge-bases/kb/wiki/auto-fix", "/api/v1/knowledge-chat/s", "/api/v1/agent-chat/s", "/api/v1/embed/knowledge-chat/s", "/api/v1/initialization/remote/check", "/api/v1/models/m/debug", "/mcp/endpoint", "/api/v1/unknown-new-generation"} {
+		require.False(t, retrievalOnlyRouteAllowed(http.MethodPost, path), path)
+	}
+	gin.SetMode(gin.TestMode)
+	for _, mode := range []string{"0", "1"} {
+		t.Setenv("WEKNORA_RETRIEVAL_ONLY", mode)
+		called := false
+		r := gin.New()
+		r.Use(retrievalOnlyMiddleware())
+		r.POST("/api/v1/knowledge-chat/s", func(c *gin.Context) { called = true; c.Status(204) })
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/api/v1/knowledge-chat/s", nil))
+		if mode == "1" {
+			require.False(t, called)
+			require.Equal(t, 403, w.Code)
+		} else {
+			require.True(t, called)
+			require.Equal(t, 204, w.Code)
+		}
+	}
+}
