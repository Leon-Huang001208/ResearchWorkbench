+func TestRetrievalOnlyOverridesAndDefaultCompatibility(t *testing.T) {
+	kb := &types.KnowledgeBase{}
+	on := true
+	overrides := &types.KnowledgeProcessOverrides{SummaryEnabled: &on, EnableMultimodel: &on, GraphEnabled: &on, ImageAttrsEnabled: &on, ImageVectorEnabled: &on, QuestionGenerationConfig: &types.QuestionGenerationConfig{Enabled: true}, ExtractConfig: &types.ExtractConfig{Enabled: true}}
+	t.Setenv("WEKNORA_RETRIEVAL_ONLY", "0")
+	require.True(t, ResolveProcessConfig(kb, nil).SummaryEnabled)
+	require.True(t, ResolveProcessConfig(kb, overrides).EnableMultimodel)
+	t.Setenv("WEKNORA_RETRIEVAL_ONLY", "1")
+	for _, value := range []*types.KnowledgeProcessOverrides{nil, {}, overrides} {
+		eff := ResolveProcessConfig(kb, value)
+		require.False(t, eff.SummaryEnabled)
+		require.False(t, eff.EnableMultimodel)
+		require.False(t, eff.GraphEnabled)
+		require.False(t, eff.ExtractConfig.Enabled)
+		require.False(t, eff.QuestionGenerationConfig.Enabled)
+		require.False(t, eff.ImageAttrsEnabled)
+		require.False(t, eff.ImageVectorEnabled)
+		require.False(t, eff.VLMConfig.IsEnabled())
+		require.False(t, eff.ASRConfig.IsASREnabled())
+	}
+	knowledge := &types.Knowledge{}
+	eff, err := ApplyKnowledgeProcessOverrides(context.Background(), kb, knowledge, nil, []string{"pdf"}, &on)
+	require.NoError(t, err)
+	require.False(t, eff.EnableMultimodel)
+}
