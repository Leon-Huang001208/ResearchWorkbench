diff --git a/internal/router/retrieval_only.go b/internal/router/retrieval_only.go
--- /dev/null
+++ b/internal/router/retrieval_only.go
@@ -0,0 +1,50 @@
+package router
+
+import (
+	"github.com/Tencent/WeKnora/internal/logger"
+	"github.com/gin-gonic/gin"
+	"net/http"
+	"os"
+	"strings"
+)
+
+// A pinned, fail-closed management surface prevents synchronous generation and
+// alternate IM/embed/MCP entry points from bypassing the ingestion policy.
+func retrievalOnlyRouteAllowed(method, path string) bool {
+	if strings.HasPrefix(path, "/mcp") {
+		return false
+	}
+	if !strings.HasPrefix(path, "/api/") {
+		return method == http.MethodGet || method == http.MethodHead
+	}
+	if !strings.HasPrefix(path, "/api/v1/") {
+		return false
+	}
+	p := strings.TrimPrefix(path, "/api/v1/")
+	if strings.Contains(p, "regenerate") || strings.Contains(p, "/wiki") || strings.Contains(p, "/profile/generate") || strings.HasSuffix(p, "/debug") || strings.HasSuffix(p, "/test") && p != "initialization/embedding/test" {
+		return false
+	}
+	if strings.HasPrefix(p, "initialization/") {
+		return method == http.MethodGet && strings.HasPrefix(p, "initialization/config/") || method == http.MethodPost && p == "initialization/embedding/test"
+	}
+	segment := strings.SplitN(p, "/", 2)[0]
+	switch segment {
+	case "auth", "users", "tenants", "organizations", "kb-shares", "shared-knowledge-bases", "knowledge-bases", "knowledge", "chunks", "models", "knowledge-search", "files", "resources", "storage-backends", "storage-providers", "vector-stores":
+		return true
+	case "system", "config", "tasks", "processing-status", "version":
+		return method == http.MethodGet || method == http.MethodHead
+	default:
+		return false
+	}
+}
+
+func retrievalOnlyMiddleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if os.Getenv("WEKNORA_RETRIEVAL_ONLY") == "1" && !retrievalOnlyRouteAllowed(c.Request.Method, c.Request.URL.Path) {
+			logger.Warn(c.Request.Context(), "retrieval_only_route_denied")
+			c.AbortWithStatusJSON(http.StatusForbidden, gin.H{"success": false, "error": "retrieval_only_generation_disabled"})
+			return
+		}
+		c.Next()
+	}
+}
