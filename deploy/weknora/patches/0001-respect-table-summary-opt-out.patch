+
+// tableSummaryOptOutEnqueuer records queue calls without Redis or model access.
+type tableSummaryOptOutEnqueuer struct {
+	tasks []*asynq.Task
+}
+
+func (q *tableSummaryOptOutEnqueuer) Enqueue(task *asynq.Task, _ ...asynq.Option) (*asynq.TaskInfo, error) {
+	q.tasks = append(q.tasks, task)
+	return &asynq.TaskInfo{ID: "summary-opt-out-fixture", Queue: types.QueueSummary}, nil
+}
+
+func TestEnqueueDataTableSummaryHonorsExplicitOptOut(t *testing.T) {
+	enabled, disabled := true, false
+	cases := []struct {
+		name     string
+		fileName string
+		fileType string
+		override *types.KnowledgeProcessOverrides
+		want     int
+	}{
+		{name: "nil override keeps xlsx default", fileName: "data.xlsx", fileType: "xlsx", want: 1},
+		{name: "omitted switch keeps csv default", fileName: "data.csv", fileType: "csv", override: &types.KnowledgeProcessOverrides{}, want: 1},
+		{name: "explicit true keeps xls enabled", fileName: "data.xls", fileType: "xls", override: &types.KnowledgeProcessOverrides{SummaryEnabled: &enabled}, want: 1},
+		{name: "explicit false skips xlsx", fileName: "data.xlsx", fileType: "xlsx", override: &types.KnowledgeProcessOverrides{SummaryEnabled: &disabled}},
+		{name: "explicit false skips csv", fileName: "data.csv", fileType: "csv", override: &types.KnowledgeProcessOverrides{SummaryEnabled: &disabled}},
+		{name: "explicit false skips xls", fileName: "data.xls", fileType: "xls", override: &types.KnowledgeProcessOverrides{SummaryEnabled: &disabled}},
+		{name: "filename fallback keeps default", fileName: "data.xlsx", want: 1},
+		{name: "non-spreadsheet stays excluded", fileName: "data.pdf", fileType: "pdf"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			queue := &tableSummaryOptOutEnqueuer{}
+			enqueueDataTableSummaryIfNeeded(context.Background(), queue, 1, "knowledge-fixture", tc.fileName, tc.fileType, "summary-fixture", "embedding-fixture", tc.override)
+			if got := len(queue.tasks); got != tc.want {
+				t.Fatalf("enqueued %d table summary tasks, want %d", got, tc.want)
+			}
+			if tc.want > 0 && queue.tasks[0].Type() != types.TypeDataTableSummary {
+				t.Fatalf("unexpected task type: %s", queue.tasks[0].Type())
+			}
+		})
+	}
+}
