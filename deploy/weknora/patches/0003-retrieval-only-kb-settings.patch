diff --git a/internal/handler/retrieval_only_kb_settings.go b/internal/handler/retrieval_only_kb_settings.go
--- /dev/null
+++ b/internal/handler/retrieval_only_kb_settings.go
@@ -0,0 +1,48 @@
+package handler
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/errors"
+	"github.com/Tencent/WeKnora/internal/logger"
+	"github.com/Tencent/WeKnora/internal/types"
+	"os"
+)
+
+func normalizeKBSettingsProfile(ctx context.Context, req *KBModelConfigRequest) error {
+	if os.Getenv("WEKNORA_RETRIEVAL_ONLY") != "1" {
+		if req.LLMModelID == "" {
+			return errors.NewBadRequestError("llmModelId is required")
+		}
+		return nil
+	}
+	req.LLMModelID = ""
+	req.VLMConfig = nil
+	req.ASRConfig = nil
+	req.Multimodal.Enabled = false
+	req.NodeExtract.Enabled = false
+	req.QuestionGeneration.Enabled = false
+	req.DocumentSplitting.ParserEngineRules = nil
+	logger.Info(ctx, "retrieval_only_kb_settings_enforced")
+	return nil
+}
+
+func enforceKBSettingsProfile(kb *types.KnowledgeBase) {
+	if os.Getenv("WEKNORA_RETRIEVAL_ONLY") != "1" {
+		return
+	}
+	kb.SummaryModelID = ""
+	kb.VLMConfig = types.VLMConfig{}
+	kb.ASRConfig = types.ASRConfig{}
+	kb.IndexingStrategy.WikiEnabled = false
+	kb.IndexingStrategy.GraphEnabled = false
+	kb.AutoTagConfig = nil
+	kb.ProfileConfig = nil
+	if kb.ExtractConfig != nil {
+		kb.ExtractConfig.Enabled = false
+	}
+	if kb.QuestionGenerationConfig != nil {
+		kb.QuestionGenerationConfig.Enabled = false
+	}
+	kb.ImageProcessingConfig.ImageAttrsEnabled = false
+	kb.ImageProcessingConfig.ImageVectorEnabled = false
+}
diff --git a/internal/handler/retrieval_only_kb_settings_test.go b/internal/handler/retrieval_only_kb_settings_test.go
--- /dev/null
+++ b/internal/handler/retrieval_only_kb_settings_test.go
@@ -0,0 +1,39 @@
+package handler
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestRetrievalOnlyKBSettingsPolicy(t *testing.T) {
+	t.Setenv("WEKNORA_RETRIEVAL_ONLY", "0")
+	require.Error(t, normalizeKBSettingsProfile(context.Background(), &KBModelConfigRequest{}))
+	standard := &KBModelConfigRequest{LLMModelID: "chat", EmbeddingModelID: "embedding"}
+	require.NoError(t, normalizeKBSettingsProfile(context.Background(), standard))
+	require.Equal(t, "chat", standard.LLMModelID)
+	t.Setenv("WEKNORA_RETRIEVAL_ONLY", "1")
+	request := &KBModelConfigRequest{LLMModelID: "unapproved-chat", EmbeddingModelID: "embedding", VLMConfig: &types.VLMConfig{Enabled: true}}
+	request.Multimodal.Enabled = true
+	request.NodeExtract.Enabled = true
+	request.QuestionGeneration.Enabled = true
+	require.NoError(t, normalizeKBSettingsProfile(context.Background(), request))
+	require.Empty(t, request.LLMModelID)
+	require.Nil(t, request.VLMConfig)
+	require.False(t, request.Multimodal.Enabled)
+	require.False(t, request.NodeExtract.Enabled)
+	require.False(t, request.QuestionGeneration.Enabled)
+	require.Equal(t, "embedding", request.EmbeddingModelID)
+	kb := &types.KnowledgeBase{ID: "kb", Name: "name", EmbeddingModelID: "embedding", SummaryModelID: "chat", IndexingStrategy: types.IndexingStrategy{VectorEnabled: true, KeywordEnabled: true, WikiEnabled: true, GraphEnabled: true}, ExtractConfig: &types.ExtractConfig{Enabled: true}, QuestionGenerationConfig: &types.QuestionGenerationConfig{Enabled: true}}
+	enforceKBSettingsProfile(kb)
+	require.Empty(t, kb.SummaryModelID)
+	require.Equal(t, "name", kb.Name)
+	require.Equal(t, "embedding", kb.EmbeddingModelID)
+	require.True(t, kb.IndexingStrategy.VectorEnabled)
+	require.True(t, kb.IndexingStrategy.KeywordEnabled)
+	require.False(t, kb.IndexingStrategy.WikiEnabled)
+	require.False(t, kb.IndexingStrategy.GraphEnabled)
+	require.False(t, kb.ExtractConfig.Enabled)
+	require.False(t, kb.QuestionGenerationConfig.Enabled)
+}
