+package router
+
+import (
+	"github.com/stretchr/testify/require"
+	"net/http"
+	"testing"
+)
+
+func TestRetrievalOnlyKBConfigRouteAdmission(t *testing.T) {
+	path := "/api/v1/initialization/config/kb"
+	require.True(t, retrievalOnlyRouteAllowed(http.MethodGet, path))
+	require.True(t, retrievalOnlyRouteAllowed(http.MethodPut, path))
+	require.False(t, retrievalOnlyRouteAllowed(http.MethodPost, path))
+	require.False(t, retrievalOnlyRouteAllowed(http.MethodPost, "/api/v1/initialization/initialize/kb"))
+	require.False(t, retrievalOnlyRouteAllowed(http.MethodPost, "/api/v1/initialization/remote/check"))
+}
