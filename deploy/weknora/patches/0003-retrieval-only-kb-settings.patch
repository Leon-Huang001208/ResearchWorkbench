@@ -0,0 +1,20 @@
+// The mode comes only from the server's read-only configuration response.
+export function requiresKBChatModel(retrievalOnly, modelID) {
+  return retrievalOnly !== true && !modelID;
+}
+
+export function retrievalOnlySubmitFields(data, retrievalOnly) {
+  if (retrievalOnly !== true) return data;
+  return {
+    ...data,
+    summary_model_id: '',
+    vlm_config: {enabled: false},
+    asr_config: {enabled: false},
+    extract_config: {enabled: false},
+    question_generation_config: {enabled: false},
+    auto_tag_config: {enabled: false},
+    profile_config: {enabled: false},
+    indexing_strategy: {...data.indexing_strategy, wiki_enabled: false, graph_enabled: false},
+    image_processing_config: {...data.image_processing_config, image_attrs_enabled: false, image_vector_enabled: false},
+  };
+}
